FROM php:8.2-apache

# ADDED: your MVC routing relies on Apache mod_rewrite.
RUN a2enmod rewrite

# ADDED: allow your existing .htaccess routing rules.
RUN sed -i 's/AllowOverride None/AllowOverride All/g' \
    /etc/apache2/apache2.conf

# ADDED: Composer needs unzip to install PHPMailer.
RUN apt-get update \
    && apt-get install -y --no-install-recommends unzip \
    && rm -rf /var/lib/apt/lists/*

# ADDED: your application's database layer uses PDO with MySQL.
RUN docker-php-ext-install pdo_mysql

# ADDED: copy Composer from the official Composer image.
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /var/www/html

# ADDED: copy the application into the Vercel image.
COPY ./src/ /var/www/html/

# ADDED: install production PHP dependencies.
RUN composer install \
    --no-dev \
    --no-interaction \
    --prefer-dist \
    --optimize-autoloader

# ADDED: store PHP sessions in Vercel's writable temporary filesystem.
RUN printf 'session.save_path="/tmp"\n' \
    > /usr/local/etc/php/conf.d/vercel-session.ini


# ============================================================
# VERCEL TEMPORARY EVENT UPLOADS
# ============================================================

# ADDED: replace the normal event upload directory with a symlink
# pointing to Vercel's writable /tmp filesystem.
RUN rm -rf /var/www/html/assets/uploads/events \
    && ln -s /tmp/event-uploads /var/www/html/assets/uploads/events


EXPOSE 80

# CHANGED: create the temporary upload directory whenever a new
# Vercel container starts, then launch Apache normally.
CMD ["sh", "-c", "mkdir -p /tmp/event-uploads && chmod 0777 /tmp/event-uploads && exec apache2-foreground"]