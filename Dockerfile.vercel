# CHANGED: minimal image purely to test Vercel's container deployment.
FROM php:8.2-apache

# ADDED: create a page without involving your application, Composer or MySQL.
RUN echo '<?php echo "Vercel PHP container works"; ?>' > /var/www/html/index.php

# ADDED: Vercel defaults container HTTP traffic to port 80.
EXPOSE 80

# ADDED: start Apache directly.
CMD ["apache2-foreground"]